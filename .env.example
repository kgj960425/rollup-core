# Rollup 백엔드 환경 변수
# .env 로 복사하고 실제 값으로 채우세요. .env는 절대 깃에 올리지 마세요.

# Supabase 프로젝트 URL
SUPABASE_URL=https://your-project.supabase.co

# Anon key (공개 가능, 프론트와 동일)
SUPABASE_ANON_KEY=eyJ...

# Service role key (절대 노출 금지!)
# Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT Secret (access_token 검증용)
# Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# CORS 허용 origin (콤마 구분)
ALLOWED_ORIGINS=http://localhost:5173

# 환경 (development | production)
ENVIRONMENT=development
